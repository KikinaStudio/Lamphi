# Copiez ce fichier en .env.local (en local) ou saisissez ces variables dans Vercel.

# Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx
# Clé secrète (ne jamais la partager ni la préfixer par NEXT_PUBLIC_)
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxx

# Adresse publique du site (liens des e-mails)
NEXT_PUBLIC_SITE_URL=https://www.amphi-sante.com

# Facultatif — e-mails de notification (nouvelle candidature, refus) via Resend
RESEND_API_KEY=
EMAIL_FROM="L'Amphi <contact@amphi-sante.com>"
# Une ou plusieurs adresses séparées par des virgules
ADMIN_NOTIFICATION_EMAIL=contact@amphi-sante.com
